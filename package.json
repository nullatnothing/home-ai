    "@types/jest": "~29.5.14",
    "@types/node": "^24.3.0",
    "@types/react": "~19.2.2",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^57.0.9",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  }
